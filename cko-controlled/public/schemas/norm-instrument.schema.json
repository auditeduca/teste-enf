{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CKO normative instrument HOLD",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "template_id",
    "status",
    "release_allowed",
    "assigns_vigencia",
    "atoms",
    "fechamento"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^BR_FED_" },
    "kind": { "const": "normative_instrument" },
    "template_id": { "const": "norm-instrument" },
    "title": { "type": "string", "minLength": 8 },
    "status": {
      "type": "string",
      "enum": ["VERIFY_PENDING", "HOLD", "QUARANTINE"]
    },
    "release": { "const": "HOLD / NOT_RELEASED" },
    "release_allowed": { "const": false },
    "assigns_vigencia": { "const": false },
    "clinical_promotion": { "const": "DENIED" },
    "b9": { "const": "HOLD / NOT_RELEASED" },
    "drive_writes": { "const": 0 },
    "supabase_ddl": { "const": 0 },
    "source": { "type": "object" },
    "fechamento": {
      "type": "object",
      "required": ["apto", "status"],
      "properties": {
        "apto": { "const": false },
        "status": { "type": "string" },
        "findings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "atoms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "type", "text", "sha256", "status"],
        "properties": {
          "id": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "type": { "type": "string" },
          "locator": { "type": "string" },
          "text": { "type": "string", "minLength": 3 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "status": { "enum": ["VERIFY_PENDING", "HOLD", "QUARANTINE"] },
          "pdf_conference": { "type": "string" }
        }
      }
    },
    "materialization": { "type": "object" }
  }
}
