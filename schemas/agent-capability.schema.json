{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentCapability",
  "type": "object",
  "required": ["agentId", "capabilityId", "purpose", "enabled"],
  "properties": {
    "agentId": { "type": "string" },
    "capabilityId": { "type": "string" },
    "agentVersion": { "type": "string" },
    "capabilityVersion": { "type": "string" },
    "purpose": { "type": "string" },
    "allowedActions": { "type": "array", "items": { "type": "string" } },
    "prohibitedActions": { "type": "array", "items": { "type": "string" } },
    "inputContractRef": { "type": "string" },
    "outputContractRef": { "type": "string" },
    "toolAllowlist": { "type": "array", "items": { "type": "string" } },
    "networkAllowlist": { "type": "array", "items": { "type": "string" } },
    "dataClassesAllowed": { "type": "array", "items": { "type": "string" } },
    "environmentAllowlist": { "type": "array", "items": { "type": "string" } },
    "riskLevel": { "type": "string" },
    "humanApprovalRule": { "type": "string" },
    "independentValidatorRefs": { "type": "array", "items": { "type": "string" } },
    "owner": { "type": "string" },
    "approverRefs": { "type": "array", "items": { "type": "string" } },
    "validFrom": { "type": "string" },
    "validUntil": { "type": "string" },
    "enabled": { "type": "boolean" },
    "status": { "type": "string" }
  }
}
