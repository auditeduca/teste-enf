{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceManifest",
  "type": "object",
  "required": ["evidenceId", "sha256", "producerRef"],
  "properties": {
    "evidenceId": { "type": "string" },
    "evidenceType": { "type": "string" },
    "artifactUri": { "type": "string" },
    "mediaType": { "type": "string" },
    "sha256": { "type": "string" },
    "size": { "type": "integer" },
    "timestamp": { "type": "string" },
    "producerRef": { "type": "string" },
    "collectorRef": { "type": "string" },
    "runId": { "type": "string" },
    "driverRefs": { "type": "array", "items": { "type": "string" } },
    "criterionRefs": { "type": "array", "items": { "type": "string" } },
    "validationRefs": { "type": "array", "items": { "type": "string" } },
    "objectRefs": { "type": "array", "items": { "type": "string" } },
    "result": { "type": "string" },
    "owner": { "type": "string" },
    "approverRefs": { "type": "array", "items": { "type": "string" } },
    "validUntil": { "type": "string" }
  }
}
