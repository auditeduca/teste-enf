{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/schema/cal-imc-001.json",
  "title": "CAL-IMC-001",
  "version": "1.0.0",
  "type": "object",
  "required": ["weight_kg", "height_m"],
  "properties": {
    "weight_kg": {
      "type": "number",
      "exclusiveMinimum": 0,
      "multipleOf": 0.01
    },
    "height_m": {
      "type": "number",
      "exclusiveMinimum": 0,
      "multipleOf": 0.001
    }
  },
  "additionalProperties": false
}
