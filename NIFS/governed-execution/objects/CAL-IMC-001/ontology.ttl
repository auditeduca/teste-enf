@prefix cko: <https://cko.calculadorasdeenfermagem.com.br/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix snomed: <http://snomed.info/id/> .

cko:CAL-IMC-001
    a cko:ClinicalCalculator ;
    cko:hasInput cko:BodyWeight ;
    cko:hasInput cko:BodyHeight ;
    cko:hasOutput cko:BodyMassIndex ;
    cko:hasUnit "kg/m2" .

cko:BodyWeight cko:mapsTo snomed:27113001 .
cko:BodyHeight cko:mapsTo snomed:50373000 .
cko:BodyMassIndex cko:mapsTo snomed:60621009 .
