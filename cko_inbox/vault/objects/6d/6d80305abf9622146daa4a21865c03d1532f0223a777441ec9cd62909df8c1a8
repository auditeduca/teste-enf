<script>
document.addEventListener("DOMContentLoaded", () => {
// BLOQUEIO DE SCROLL ACIDENTAL NOS INPUTS DA FAIXA
document.querySelectorAll(".mini-calc-input").forEach((input) => {
input.addEventListener("wheel", function (e) {
e.preventDefault();
this.blur();
});
});

// 1. GASOMETRIA
const btnMiniGaso = document.getElementById("btnMiniGaso");
const resMiniGaso = document.getElementById("res-mini-gaso");

if (btnMiniGaso) {
btnMiniGaso.addEventListener("click", () => {
const ph = parseFloat(document.getElementById("mini-ph").value);
const paco2 = parseFloat(document.getElementById("mini-paco2").value);
const hco3 = parseFloat(document.getElementById("mini-hco3").value);

if (isNaN(ph) || isNaN(paco2) || isNaN(hco3)) {
resMiniGaso.textContent = "Preencha pH, PaCO₂ e HCO₃⁻";
resMiniGaso.style.color = "#e11d48";
return;
}

let diagnostico = "";
if (ph < 7.35) {
diagnostico = paco2 > 45 ? "Acidose Respiratória" : hco3 < 22 ? "Acidose Metabólica" : "Acidose Mista";
} else if (ph > 7.45) {
diagnostico = paco2 < 35 ? "Alcalose Respiratória" : hco3 > 26 ? "Alcalose Metabólica" : "Alcalose Mista";
} else {
diagnostico = (paco2 < 35 || paco2 > 45 || hco3 < 22 || hco3 > 26) ? "Normal Compensado" : "Valores Normais";
}

resMiniGaso.style.color = "#1A3E74";
resMiniGaso.textContent = diagnostico;
});
}

// 2. MEDICAMENTOS (Regra de Três)
const btnMiniMed = document.getElementById("btnMiniMed");
const resMiniMed = document.getElementById("res-mini-med");

if (btnMiniMed) {
btnMiniMed.addEventListener("click", () => {
const presc = parseFloat(document.getElementById("mini-presc").value);
const conc = parseFloat(document.getElementById("mini-conc").value);
const vol = parseFloat(document.getElementById("mini-vol").value);

if (isNaN(presc) || isNaN(conc) || isNaN(vol) || conc === 0) {
resMiniMed.textContent = "Insira valores válidos";
resMiniMed.style.color = "#e11d48";
return;
}

const resultado = (presc * vol) / conc;
resMiniMed.style.color = "#1A3E74";
resMiniMed.textContent = `Aspirar: ${resultado.toFixed(2).replace('.', ',')} ml`;
});
}

// 3. GOTEJAMENTO
const btnMiniGot = document.getElementById("btnMiniGot");
const resMiniGot = document.getElementById("res-mini-got");

if (btnMiniGot) {
btnMiniGot.addEventListener("click", () => {
const vol = parseFloat(document.getElementById("mini-got-vol").value);
const tempo = parseFloat(document.getElementById("mini-got-tempo").value);
const tipo = document.getElementById("mini-got-tipo").value;

if (isNaN(vol) || isNaN(tempo) || tempo === 0 || vol <= 0) {
resMiniGot.textContent = "Preencha volume e tempo";
resMiniGot.style.color = "#e11d48";
return;
}

const fator = tipo === "macro" ? 20 : 60;
const gotas = (vol * fator) / (tempo * 60);
const tipoTexto = tipo === "macro" ? "gotas/min" : "microgotas/min";

resMiniGot.style.color = "#1A3E74";
resMiniGot.textContent = `${Math.round(gotas)} ${tipoTexto}`;
});
}

// 4. IMC
const btnMiniImc = document.getElementById("btnMiniImc");
const resMiniImc = document.getElementById("res-mini-imc");

if (btnMiniImc) {
btnMiniImc.addEventListener("click", () => {
const peso = parseFloat(document.getElementById("mini-imc-peso").value);
const altura = parseFloat(document.getElementById("mini-imc-alt").value);

if (isNaN(peso) || isNaN(altura) || altura === 0 || peso <= 0) {
resMiniImc.textContent = "Preencha peso e altura";
resMiniImc.style.color = "#e11d48";
return;
}

const imc = peso / (altura * altura);
let classe = "";

if (imc < 18.5) classe = "Abaixo do peso";
else if (imc < 25) classe = "Peso normal";
else if (imc < 30) classe = "Sobrepeso";
else classe = "Obesidade";

resMiniImc.style.color = "#1A3E74";
resMiniImc.textContent = `${imc.toFixed(1).replace('.', ',')} (${classe})`;
});
}
});
</script>
</main>

