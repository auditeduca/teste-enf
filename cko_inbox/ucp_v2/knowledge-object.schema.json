{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-cko-policy": "POL-CKO-UCP-001-v2.0",
  "x-cko-authority-chain": [
    "CKO-MD",
    "CKO-REG",
    "EVIDENCE"
  ],
  "x-source-attachment-sha256": "78414fda55bb6391bd51e50ae9aeca9d9ad36cc713c4d52ba8f78dcfb6bfeeb1",
  "$id": "urn:cko:schema:knowledge-object:2.0",
  "title": "CKO Knowledge Object v2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "md_ref",
    "knowledge_class",
    "atom_refs",
    "evidence_refs",
    "provenance",
    "versioning"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^KNO-[A-Z0-9-]+$"
    },
    "md_ref": {
      "type": "string"
    },
    "reg_profile_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "knowledge_class": {
      "type": "string"
    },
    "atom_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "relationship_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_chain",
        "hash"
      ],
      "properties": {
        "source_chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hash": {
          "type": "string"
        },
        "jurisdiction_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "versioning": {
      "type": "object",
      "required": [
        "version",
        "status"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "status": {
          "enum": [
            "DRAFT",
            "CONTROLLED_CANDIDATE",
            "VALIDATED",
            "RELEASED",
            "HOLD",
            "SUPERSEDED"
          ]
        }
      }
    }
  }
}