{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-cko-policy": "POL-CKO-UCP-001-v2.0",
  "x-cko-authority-chain": [
    "CKO-MD",
    "CKO-REG",
    "EVIDENCE"
  ],
  "x-source-attachment-sha256": "78414fda55bb6391bd51e50ae9aeca9d9ad36cc713c4d52ba8f78dcfb6bfeeb1",
  "$id": "urn:cko:schema:content-object:2.0",
  "title": "CKO Content Object v2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "content_profile",
    "knowledge_ref",
    "atom_refs",
    "depth_model_ref",
    "audience_refs",
    "validation",
    "versioning"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^OBJ-[A-Z0-9-]+$"
    },
    "content_profile": {
      "type": "string"
    },
    "knowledge_ref": {
      "type": "string"
    },
    "atom_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "depth_model_ref": {
      "const": "DEPTH-L1-L4-v2.0"
    },
    "audience_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "specialty_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "locale_policy_ref": {
      "type": "string",
      "default": "POL-I18N-FAILCLOSED"
    },
    "library_memberships": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "relationship_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "allowed_recipe_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "seo_profile_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "accessibility_profile_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "media_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "validation": {
      "type": "object",
      "required": [
        "validator_refs",
        "release_gate_ref"
      ],
      "properties": {
        "validator_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caat_profile_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "ipe_profile_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "audit_profile_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "release_gate_ref": {
          "type": "string"
        }
      }
    },
    "versioning": {
      "type": "object",
      "required": [
        "version",
        "status",
        "content_hash"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "status": {
          "enum": [
            "DRAFT",
            "CONTROLLED_CANDIDATE",
            "VALIDATED",
            "RELEASED",
            "HOLD",
            "SUPERSEDED"
          ]
        },
        "content_hash": {
          "type": "string"
        }
      }
    }
  }
}