{
  "hosting": {
    "public": "reference-website",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "ar/**",
      "bg/**",
      "cs/**",
      "da/**",
      "de/**",
      "en/**",
      "es/**",
      "fi/**",
      "fr/**",
      "hi/**",
      "hr/**",
      "hu/**",
      "id/**",
      "it/**",
      "ja/**",
      "ko/**",
      "nl/**",
      "no/**",
      "pl/**",
      "ro/**",
      "ru/**",
      "sl/**",
      "sr/**",
      "sv/**",
      "th/**",
      "tr/**",
      "uk/**",
      "vi/**",
      "zh/**",
      "docs/**",
      "docs-internos/**",
      "scripts/**",
      "templates/**",
      "tools/**",
      "cdn-cgi/**",
      "cko-relatorio-tecnico-final.html",
      "grafo-clinico.html",
      "admin.html"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-CKO-Release", "value": "HOLD_NOT_RELEASED" }
        ]
      }
    ],
    "cleanUrls": true
  }
}
